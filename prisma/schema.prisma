generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_Three")
}

model User {
  id                Int             @id @default(autoincrement())
  username          String          @unique
  password          String?
  email             String          @unique
  emailVerified     Boolean?
  verificationToken String?         @unique
  tokenExpiry       DateTime?
  isAdmin           Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  learnedWords      LearnedWord[]
  unlearnedWords    UnlearnedWord[]
  favoriteWords     FavoriteWord[]
  dailyGoals        DailyGoal[]
  examResults       ExamResult[]
  racePresence      RacePresence?
  raceInvitesSent   RaceInvite[]  @relation("RaceInvitesSent")
  raceInvitesRecv   RaceInvite[]  @relation("RaceInvitesReceived")
  raceResults       RaceResult[]
}

model Module {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  name        String
  description String?
  sortOrder   Int     @default(0)
  words       Word[]
}

model Word {
  id          Int             @id @default(autoincrement())
  english     String
  turkish     String
  category    String?
  moduleId    Int
  module      Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  addedBy     String
  /** Kart arka plan görseli — örn. /word-images/12.jpg */
  imageUrl    String?
  /** Gemini’ye verilen görsel promptu (yeniden üretim için) */
  imagePrompt String?
  createdAt   DateTime        @default(now())
  learnedBy   LearnedWord[]
  unlearnedBy UnlearnedWord[]
  favoritedBy FavoriteWord[]

  @@unique([moduleId, english])
  @@index([moduleId, category])
}

model FavoriteWord {
  id        Int      @id @default(autoincrement())
  userId    Int
  wordId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, createdAt])
}

model UnlearnedWord {
  id        Int      @id @default(autoincrement())
  userId    Int
  wordId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
}

model LearnedWord {
  id        Int      @id @default(autoincrement())
  userId    Int
  wordId    Int
  isLearned Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
}

model DailyGoal {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime @default(now())
  completed Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model ExamResult {
  id            Int      @id @default(autoincrement())
  userId        Int
  questionCount Int
  correctCount  Int
  wrongCount    Int
  score         Float
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model RacePresence {
  userId     Int      @id
  ready      Boolean  @default(true)
  lastSeen   DateTime @default(now())
  moduleId   Int?
  groupIndex Int      @default(1)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RaceInvite {
  id         Int      @id @default(autoincrement())
  fromUserId Int
  toUserId   Int
  moduleId   Int
  groupIndex Int
  status     String   @default("pending")
  matchId    Int?
  createdAt  DateTime @default(now())
  fromUser   User     @relation("RaceInvitesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("RaceInvitesReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@index([createdAt])
}

model RaceMatch {
  id         Int          @id @default(autoincrement())
  player1Id  Int
  player2Id  Int
  moduleId   Int
  groupIndex Int
  questions  Json
  status     String       @default("playing")
  winnerId   Int?
  startedAt  DateTime     @default(now())
  createdAt  DateTime     @default(now())
  results    RaceResult[]

  @@index([player1Id, status])
  @@index([player2Id, status])
}

model RaceResult {
  id            Int       @id @default(autoincrement())
  matchId       Int
  userId        Int
  opponentId    Int
  correctCount  Int
  questionCount Int
  durationMs    Int
  won           Boolean   @default(false)
  draw          Boolean   @default(false)
  points        Int       @default(0)
  createdAt     DateTime  @default(now())
  match         RaceMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId, createdAt])
}
